<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Texas-TAK palette. ATAK is dark by default; surfaces are near-black
         with a single warm brand accent (Texas-TAK gold, the bee/honeycomb
         mark). Hex values are the canonical Texas-TAK platform design
         tokens (texastak_platform ui.py): bg #070707, card #121212,
         card-2 #181818, text #F4F4F4, muted #A9A9A9, accent #F2B33D,
         accent-hover #C98A12, ok #79D99B. Status colors keep the
         green=nominal / amber=transitioning / red=error convention; the
         transitioning amber is the brand gold, and red (no brand token) is
         retained for error / transmit since red carries that meaning
         universally. -->
    <color name="xv_bg">#070707</color>
    <color name="xv_surface">#121212</color>
    <color name="xv_surface_alt">#181818</color>
    <color name="xv_text">#F4F4F4</color>
    <color name="xv_text_dim">#A9A9A9</color>
    <color name="xv_accent">#F2B33D</color>
    <color name="xv_accent_hover">#C98A12</color>
    <color name="xv_ok">#79D99B</color>
    <color name="xv_warn">#F2B33D</color>
    <color name="xv_err">#FF5252</color>
    <color name="xv_ptt_idle">#F2B33D</color>
    <color name="xv_ptt_active">#FF5252</color>
</resources>
